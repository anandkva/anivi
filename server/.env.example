# Copy to server/.env for local development. That file is git-ignored —
# never commit real credentials.
#
# In production these are set in the Render dashboard (Environment tab),
# not in a file.

PORT=8080
ANIVI_ALLOWED_ORIGINS=*

# --- Chat history (optional) ---
# Without this the app runs exactly as before: live drawing and Miss You,
# but no saved conversation.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/anivi?retryWrites=true&w=majority
MONGODB_DATABASE=anivi

# --- Image attachments (optional) ---
# An IAM user with s3:PutObject and s3:GetObject on this bucket only.
# Keep the bucket private: Anivi serves images through short-lived signed URLs.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: set only if the bucket is fronted by CloudFront or is public.
# AWS_PUBLIC_BASE_URL=https://dxxxxx.cloudfront.net
