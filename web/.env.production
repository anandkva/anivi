# Production endpoints, used automatically by `vite build` (and therefore by
# Vercel). Committed on purpose so a deploy needs no dashboard configuration.
#
# The realtime server on Render. It must be wss:// — an https:// page cannot
# open a plain ws:// socket. The REST base (pairing + widget snapshot) is
# derived from this: wss://host/ws -> https://host
VITE_WS_URL=wss://anivi-server.onrender.com/ws

# Set this only if the API ever moves to a different host than the socket.
# VITE_API_URL=https://anivi-server.onrender.com
