# Copy to .env.local for local work, and set the same values in your Vercel
# project settings for production. Nothing in the code hardcodes a host.

# The only variable you must set in production: the realtime endpoint.
# Local:      ws://localhost:8080/ws
# Production: wss://<your-server-host>/ws   (wss:// — a https:// page cannot open a ws:// socket)
VITE_WS_URL=ws://localhost:8080/ws

# Optional. The REST base (pairing + widget snapshot) is derived from
# VITE_WS_URL by default: wss://host/ws -> https://host. Set this only if the
# two live on different hosts.
# VITE_API_URL=https://api.example.com
