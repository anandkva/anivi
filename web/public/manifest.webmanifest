{
  "name": "Anivi",
  "short_name": "Anivi",
  "description": "A little space for us ❤️",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fff5f8",
  "theme_color": "#ff5c8a",
  "categories": ["social", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Miss You ❤️",
      "short_name": "Miss You",
      "url": "/?action=miss_you",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "widgets": [
    {
      "name": "Anivi",
      "short_name": "Anivi",
      "description": "Your latest shared drawing and activity",
      "tag": "anivi-space",
      "template": "anivi-space",
      "ms_ac_template": "/widgets/anivi-card.json",
      "data": "/widgets/anivi-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icons/icon-512.png",
          "sizes": "512x512",
          "label": "Anivi widget"
        }
      ],
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }],
      "auth": false,
      "update": 900
    }
  ]
}
